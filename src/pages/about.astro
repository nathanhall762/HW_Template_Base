---
import type { DocumentData } from 'firebase/firestore';
import { getData } from '../firebase';
import PageLayout from '../layouts/PageLayout.astro';

// get url slug from this file name, the page name
const slug = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.replace(/^\/|\/$/g, '');
const data = await getData('pages', slug);
const pageData: DocumentData = data[0];
---

<PageLayout
  title={pageData.title}
  metaDescription={pageData.seo_metadata.meta_description}
  pageData={pageData}
/>