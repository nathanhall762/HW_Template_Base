---
/* Imports */
import Header from '../components/shared/Header';
import Footer from '../components/shared/Footer';
import { ViewTransitions } from 'astro:transitions';
import { getData } from '../firebase';
import { structuredData } from '../structuredData';

/* Types / Interfaces */
interface Props {
  title: string;
  metaDescription: string;
}

/* Props */
const { title, metaDescription } = Astro.props as Props;

/* Data Fetching */
// get page names from Pages collection
const navs = (await getData('pages'))
  .filter((page) => page.slug !== 'home')
  .map((page) => ({
    name: page.title,
    link: `/${page.slug}`,
  }));

// get business information collection
const businessInformation = await getData('business_information');
const business = businessInformation[0];
---

<!doctype html>
<html
  lang='en'
  class='scroller dark bg-neutral-9 font-sans font-light text-neutral-9'
>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={metaDescription} />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <link
      rel='icon'
      type='image/png'
      sizes='32x32'
      href={business?.favicon.favicon_32_x32}
    />
    <title>
      {
        title
          ? `${title} - ${business?.business_name}`
          : business?.business_name
      }
    </title>
    <ViewTransitions />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <Header
      phone={business?.business_phone}
      address={business?.business_address}
      addressLink={business?.google_maps_link}
      email={business?.business_contact_email}
      socials={business?.socials}
      navs={navs.filter((nav) => nav.link !== '/')}
      logo={business?.business_logo}
      client:load
    />
    <main class='bg-neutral-8'>
      <slot />
    </main>
    <Footer
      address={business?.business_address}
      copyright=`${business?.business_name} 2026`
      email={business?.business_contact_email}
      navs={navs}
      phone={business?.business_phone}
      socials={business?.socials}
    />
    <style is:global>
      :root {
        --primary-hue: 180;
        --primary-saturation: 92;
        --neutral-hue: 240;
        --neutral-saturation: 5;
      }

      body {
        @apply text-neutral-9 dark:text-neutral-1;
      }

      a {
        @apply transition-transform duration-fast ease-in-out;
      }

      a:hover {
        @apply scale-md;
      }

      strong {
        font-weight: bold;
      }

      h1 {
        @apply text-3xl font-semibold lg:text-4xl;
      }

      h2 {
        @apply text-2xl font-semibold lg:text-3xl;
      }

      h3 {
        @apply text-xl font-semibold lg:text-2xl;
      }

      h4 {
        @apply text-lg font-semibold lg:text-xl;
      }

      h5 {
        @apply text-base font-semibold lg:text-lg;
      }

      h6 {
        @apply text-base font-semibold lg:text-lg;
      }

      p {
        @apply text-base leading-loose lg:text-lg lg:leading-loose;
      }
    </style>
  </body>
</html>
