---
import ContactSection from '../components/shared/ContactSection';
import type { DocumentData } from 'firebase/firestore';
import ReviewCards from '../components/ReviewCards';
import { getData } from '../firebase';
import PageBuilder from '../components/shared/PageBuilder.astro';
import BaseLayout from './BaseLayout.astro';

/* Types / Interfaces */
interface Props {
  title: string;
  metaDescription: string;
  pageData: DocumentData;
}

/* Props */
const { title, metaDescription, pageData } = Astro.props;


/* Data Fetching */
// get business information collection
const businessInformation = await getData('business_information');
const business = businessInformation[0];

// if we get reviewData, we use that, if not - we repeat our dummy review data 5 times in an array
let reviews;
if (import.meta.env.PROD === true) {
  const { reviewData } = await import('../googleReviews');
  reviews = reviewData;
} else {
  reviews = Array(5).fill({
  name: 'Customer Name',
  authorAttribution: { displayName: 'Customer Name', photoUri: '', uri: '' },
  originalText: { languageCode: 'en', text: 'The customer\'s review will go here' },
  publishTime: 'publish time',
  rating: 5,
  text: { languageCode: 'en', text: 'The customer\'s review will go here' },
  relativePublishTimeDescription: 'this is great',
});
}

// get url path name
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} metaDescription={metaDescription}>
  <PageBuilder pageData={pageData} />
  <slot />
  <ReviewCards heading='Reviews' reviews={reviews} />
  <ContactSection
    businessName={business?.business_name}
    businessAddress={business?.business_address}
    businessPhone={business?.business_phone}
    businessEmail={business?.business_contact_email}
    currentPath={currentPath}
    client:idle
  />
</BaseLayout>
